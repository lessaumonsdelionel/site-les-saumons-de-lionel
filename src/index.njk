---
layout: "base.njk"
permalink: "index.html"
pageId: "accueil"
eleventyComputed:
  titre: "{{ accueil.seo.titre | safe }}"
  description: "{{ accueil.seo.description | safe }}"
  ogTitre: "{{ accueil.seo.ogTitre | safe }}"
  ogDescription: "{{ accueil.seo.ogDescription | safe }}"
  ogImage: "{{ site.ogImage | safe }}"
---
{% import "macros.njk" as m %}
<!-- ============================== HERO ============================== -->
<section class="hero">
  <div class="bg" style="background-image:url('{{ accueil.hero.imageFond | safe }}')"></div>
  <div class="wrap">
    <span class="eyebrow">{{ accueil.hero.eyebrow | safe }}</span>
    <h1>{{ accueil.hero.titre | safe }}</h1>
    <p class="lead">{{ accueil.hero.accroche | safe }}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="commande.html">{{ accueil.hero.boutonPrincipal | safe }} <span class="arr">→</span></a>
      <a class="btn btn-ghost light" href="nos-produits.html">{{ accueil.hero.boutonSecondaire | safe }}</a>
    </div>
    {{ m.sceau(site, "hero", "assets/img/logo-blanc.png") }}
    <div class="hero-foot">
      <div class="scroll-hint"><span class="line"></span> Descendre</div>
      {% if accueil.hero.legende %}<span class="legende">{{ accueil.hero.legende | safe }}</span>{% endif %}
      <span class="coords">{{ accueil.hero.noteBas | safe }}</span>
    </div>
  </div>
</section>

<!-- ============================== TROIS FAITS ============================== -->
<section class="faits" id="faits">
  <div class="wrap">
    <span class="eyebrow reveal">{{ accueil.faits.eyebrow | safe }}</span>
    <h2 class="reveal">{{ accueil.faits.titre | safe }}</h2>
    <div class="props">{% for p in accueil.faits.liste %}
      <div class="prop reveal"{% if not loop.first %} data-d="{{ loop.index0 }}"{% endif %}>
        <span class="lat"><span class="bar"><i></i></span> {{ p.label | safe }}</span>
        <h3>{{ p.titre | safe }}</h3>
        <p>{{ p.texte | safe }}</p>
      </div>{% endfor %}
    </div>
  </div>
</section>

<!-- ============================== NOS PRODUITS ============================== -->
<section class="alt" id="produits">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow reveal">{{ accueil.produits.eyebrow | safe }}</span>
        <h2 class="reveal">{{ accueil.produits.titre | safe }}</h2>
      </div>
      <p class="side reveal">{{ accueil.produits.texteCote | safe }}</p>
    </div>
    <div class="grid4">{% for p in produits.liste %}
      <article class="card reveal"{% if not loop.first %} data-d="{{ loop.index0 }}"{% endif %}>
        <a href="nos-produits.html#{{ p.id | safe }}">
          <div class="ph"><span class="tag">{{ p.eyebrow | safe }}</span><img src="{{ p.image | safe }}" alt="{{ p.alt | safe }}" loading="lazy"></div>
          <div class="body">
            <h3>{{ p.court | safe }}</h3>
            <span class="wt">{{ p.sousTitre | safe }}</span>
            <div class="foot"><span>{{ accueil.produits.note | safe }}</span><span class="arr">→</span></div>
          </div>
        </a>
      </article>{% endfor %}
    </div>
    <div class="cta-row reveal" style="margin-top:38px;display:flex;gap:16px 28px;flex-wrap:wrap;align-items:center">
      <a class="btn btn-ghost" href="nos-produits.html">{{ accueil.produits.bouton | safe }}</a>
      <a class="link-more" href="contact.html?profil=particulier">{{ accueil.produits.horsCseLien | safe }} <span class="arr">→</span></a>
    </div>
  </div>
</section>

<!-- ============================== LIONEL ============================== -->
<section id="lionel">
  <div class="wrap split">
    <div class="reveal">{{ m.figure(accueil.histoire.image, accueil.histoire.imageAlt, accueil.histoire.legende) }}</div>
    <div>
      <span class="eyebrow reveal">{{ accueil.histoire.eyebrow | safe }}</span>
      <h2 class="reveal">{{ accueil.histoire.titre | safe }}</h2>{% for p in accueil.histoire.paragraphes %}
      <p class="reveal">{{ p | safe }}</p>{% endfor %}
      <a class="link-more reveal" href="notre-histoire.html">{{ accueil.histoire.lien | safe }} <span class="arr">→</span></a>
    </div>
  </div>
</section>

<!-- ============================== AVIS (affiché dès qu'un retour est saisi) ============================== -->
{% if accueil.avis.liste and accueil.avis.liste.length %}
<section class="alt">
  <div class="wrap">
    <span class="eyebrow reveal">{{ accueil.avis.eyebrow | safe }}</span>
    <h2 class="reveal" style="font-size:clamp(30px,3.8vw,50px);margin-top:16px">{{ accueil.avis.titre | safe }}</h2>
    <div class="avis">{% for a in accueil.avis.liste %}
      <blockquote class="avis-item reveal"{% if not loop.first %} data-d="{{ loop.index0 }}"{% endif %}>
        <p>{{ a.texte | safe }}</p>
        <footer><b>{{ a.auteur | safe }}</b>{% if a.contexte %} <span>· {{ a.contexte | safe }}</span>{% endif %}</footer>
      </blockquote>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ============================== CHAÎNE DU FROID ============================== -->
<section class="process on-dark" id="froid">
  <div class="wrap">
    <span class="eyebrow reveal">{{ accueil.froid.eyebrow | safe }}</span>
    <h2 class="reveal" style="font-size:clamp(30px,3.8vw,50px);margin-top:16px;max-width:22ch">{{ accueil.froid.titre | safe }}</h2>
    <div class="steps">{% for e in accueil.froid.etapes %}
      <div class="step reveal"{% if not loop.first %} data-d="{{ loop.index0 }}"{% endif %}><span class="n">{{ e.temp | safe }}</span><h3>{{ e.titre | safe }}</h3><p>{{ e.texte | safe }}</p></div>{% endfor %}
    </div>
  </div>
</section>

<!-- ============================== CSE ============================== -->
<section class="cse-band on-dark" id="cse">
  <div class="bgimg" style="background-image:url('{{ accueil.cse.imageFond | safe }}')"></div>
  <div class="wrap">
    <span class="eyebrow reveal">{{ accueil.cse.eyebrow | safe }}</span>
    <h2 class="reveal">{{ accueil.cse.titre | safe }}</h2>
    <p class="reveal">{{ accueil.cse.texte | safe }}</p>
    <div class="code-pill reveal" data-d="1"><span class="dot"></span> {{ accueil.cse.codeExemple | safe }}</div>
    <div class="reveal" data-d="2"><a class="btn btn-primary" href="commande.html">{{ accueil.cse.bouton | safe }} <span class="arr">→</span></a></div>
    <p class="reveal" data-d="3" style="margin-top:26px"><a class="link-more" href="offres-cse.html" style="color:var(--saumon)">{{ accueil.cse.lien | safe }} <span class="arr">→</span></a></p>
  </div>
</section>
