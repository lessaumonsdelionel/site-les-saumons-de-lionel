<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ titre | safe }}</title>
{% if description %}<meta name="description" content="{{ description | safe }}">
{% endif %}{% if noindex %}<meta name="robots" content="noindex">
{% endif %}{% if ogTitre %}<meta property="og:title" content="{{ ogTitre | safe }}">
<meta property="og:description" content="{{ ogDescription | safe }}">
<meta property="og:image" content="{{ ogImage | safe }}">
<meta property="og:type" content="website">
{% endif %}<link rel="icon" type="image/png" href="{{ site.favicon | safe }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Space+Mono&display=swap" rel="stylesheet">
<link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/styles.css">
</head>
<body class="header-dark">

{% include "header.njk" %}
{{ content | safe }}
{% if footerSimple %}{% include "footer-simple.njk" %}{% else %}<!-- ============================== FOOTER ============================== -->
{% include "footer.njk" %}{% endif %}
<script src="js/main.js"></script>
{% if scriptIframe %}<script>
/* Ajuste la hauteur de l'iframe à son contenu (même origine). */
(function () {
  var f = document.querySelector(".widget-frame");
  if (!f) return;
  function fit() {
    try {
      var d = f.contentDocument;
      if (d && d.body) f.style.height = Math.max(300, d.body.scrollHeight + 24) + "px";
    } catch (e) { /* origine différente : on garde la hauteur CSS */ }
  }
  f.addEventListener("load", function () { fit(); setInterval(fit, 400); });
})();
</script>
{% endif %}</body>
</html>
